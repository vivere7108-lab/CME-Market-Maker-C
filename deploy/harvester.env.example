# Arguments and secrets the harvester service runs with.
#   sudo systemctl restart harvester    # after any change here
#
# The Databento key is read from the environment, never from a config file.
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# It ships in --dry-run: the real book is read, every decision is taken and
# journalled, fills are simulated off the real tape, and nothing reaches
# IBKR. A dry run needs no gateway at all. Run it that way for at least a
# full session, then read
#
#   harvester report -c configs/es_paper.yaml
#
# and in particular the markouts by toxicity level, before taking the flag
# off. A dry run exercises everything except the order path, so it is the
# cheapest way to find out that the feed is not entitled, that the gate
# never warms up, or that the quotes only ever fill into sweeps.
#
# When you are ready to route to the PAPER account, delete --dry-run:
#
#   HARVESTER_ARGS=live -c configs/es_paper.yaml
#
# The binary refuses to route ANY non-dry-run order -- paper included --
# unless ibkr.allow_live_trading is true in the config, so es_paper.yaml
# already sets it. The account actually used is decided by which account
# the Gateway session is logged into (TradingMode in /etc/ibc/config.ini),
# not by this file.

HARVESTER_ARGS=live -c configs/es_paper.yaml --dry-run
